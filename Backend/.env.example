# Configuração do LanHouse Monitor Backend

PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (Porta 5433 no host para não conflitar com PostgreSQL local do Windows na 5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=lanhouse
POSTGRES_USER=lanhouse
POSTGRES_PASSWORD=lanhouse

# MongoDB (Replica Set rs0 nas portas 27017, 27018, 27019)
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=lanhouse

# Apache Cassandra (Cluster de 3 nós nas portas 9042, 9043, 9044)
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORTS=9042,9043,9044
CASSANDRA_KEYSPACE=lanhouse
